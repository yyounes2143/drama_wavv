    d1 = {
        "\u0000r\n\u0000\n\u0002\u0010\u0008\n\u0002\u0018\u0002\n\u0002\u0010\t\n\u0002\u0018\u0002\n\u0002\u0010\u000c\n\u0002\u0018\u0002\n\u0002\u0008\u0007\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0008\n\u0002\u0010\u000b\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0000\n\u0002\u0010\u0005\n\u0002\u0008\u0002\n\u0002\u0010\n\n\u0000\n\u0002\u0010\u0006\n\u0000\n\u0002\u0010\u0007\n\u0000\n\u0002\u0018\u0002\n\u0002\u0008\u001a\n\u0002\u0010\u000f\n\u0002\u0008\u0007\n\u0002\u0018\u0002\n\u0002\u0008\u0003\u001a\u000c\u0010\u0000\u001a\u00020\u0001*\u00020\u0002H\u0007\u001a\u000c\u0010\u0000\u001a\u00020\u0003*\u00020\u0004H\u0007\u001a\u000c\u0010\u0000\u001a\u00020\u0005*\u00020\u0006H\u0007\u001a\u0013\u0010\u0007\u001a\u0004\u0018\u00010\u0001*\u00020\u0002H\u0007\u00a2\u0006\u0002\u0010\u0008\u001a\u0013\u0010\u0007\u001a\u0004\u0018\u00010\u0003*\u00020\u0004H\u0007\u00a2\u0006\u0002\u0010\t\u001a\u0013\u0010\u0007\u001a\u0004\u0018\u00010\u0005*\u00020\u0006H\u0007\u00a2\u0006\u0002\u0010\n\u001a\u000c\u0010\u000b\u001a\u00020\u0001*\u00020\u0002H\u0007\u001a\u000c\u0010\u000b\u001a\u00020\u0003*\u00020\u0004H\u0007\u001a\u000c\u0010\u000b\u001a\u00020\u0005*\u00020\u0006H\u0007\u001a\u0013\u0010\u000c\u001a\u0004\u0018\u00010\u0001*\u00020\u0002H\u0007\u00a2\u0006\u0002\u0010\u0008\u001a\u0013\u0010\u000c\u001a\u0004\u0018\u00010\u0003*\u00020\u0004H\u0007\u00a2\u0006\u0002\u0010\t\u001a\u0013\u0010\u000c\u001a\u0004\u0018\u00010\u0005*\u00020\u0006H\u0007\u00a2\u0006\u0002\u0010\n\u001a\r\u0010\r\u001a\u00020\u0001*\u00020\u000eH\u0087\u0008\u001a\r\u0010\r\u001a\u00020\u0003*\u00020\u000fH\u0087\u0008\u001a\r\u0010\r\u001a\u00020\u0005*\u00020\u0010H\u0087\u0008\u001a\u0014\u0010\r\u001a\u00020\u0001*\u00020\u000e2\u0006\u0010\r\u001a\u00020\u0011H\u0007\u001a\u0014\u0010\r\u001a\u00020\u0003*\u00020\u000f2\u0006\u0010\r\u001a\u00020\u0011H\u0007\u001a\u0014\u0010\r\u001a\u00020\u0005*\u00020\u00102\u0006\u0010\r\u001a\u00020\u0011H\u0007\u001a\u0014\u0010\u0012\u001a\u0004\u0018\u00010\u0001*\u00020\u000eH\u0087\u0008\u00a2\u0006\u0002\u0010\u0013\u001a\u0014\u0010\u0012\u001a\u0004\u0018\u00010\u0003*\u00020\u000fH\u0087\u0008\u00a2\u0006\u0002\u0010\u0014\u001a\u0014\u0010\u0012\u001a\u0004\u0018\u00010\u0005*\u00020\u0010H\u0087\u0008\u00a2\u0006\u0002\u0010\u0015\u001a\u001b\u0010\u0012\u001a\u0004\u0018\u00010\u0001*\u00020\u000e2\u0006\u0010\r\u001a\u00020\u0011H\u0007\u00a2\u0006\u0002\u0010\u0016\u001a\u001b\u0010\u0012\u001a\u0004\u0018\u00010\u0003*\u00020\u000f2\u0006\u0010\r\u001a\u00020\u0011H\u0007\u00a2\u0006\u0002\u0010\u0017\u001a\u001b\u0010\u0012\u001a\u0004\u0018\u00010\u0005*\u00020\u00102\u0006\u0010\r\u001a\u00020\u0011H\u0007\u00a2\u0006\u0002\u0010\u0018\u001a\u001c\u0010\u0019\u001a\u00020\u001a*\u00020\u000e2\u0008\u0010\u001b\u001a\u0004\u0018\u00010\u0001H\u0087\n\u00a2\u0006\u0002\u0010\u001c\u001a\u001c\u0010\u0019\u001a\u00020\u001a*\u00020\u000f2\u0008\u0010\u001b\u001a\u0004\u0018\u00010\u0003H\u0087\n\u00a2\u0006\u0002\u0010\u001d\u001a\u001c\u0010\u0019\u001a\u00020\u001a*\u00020\u00102\u0008\u0010\u001b\u001a\u0004\u0018\u00010\u0005H\u0087\n\u00a2\u0006\u0002\u0010\u001e\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00010\u001f2\u0006\u0010 \u001a\u00020!H\u0087\u0002\u00a2\u0006\u0002\u0008\"\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00030\u001f2\u0006\u0010 \u001a\u00020!H\u0087\u0002\u00a2\u0006\u0002\u0008#\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020$0\u001f2\u0006\u0010 \u001a\u00020!H\u0087\u0002\u00a2\u0006\u0002\u0008%\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020&0\u001f2\u0006\u0010 \u001a\u00020!H\u0087\u0002\u00a2\u0006\u0002\u0008\'\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020(0\u001f2\u0006\u0010 \u001a\u00020!H\u0087\u0002\u00a2\u0006\u0002\u0008)\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00010*2\u0006\u0010 \u001a\u00020!H\u0087\u0002\u00a2\u0006\u0002\u0008\"\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00030*2\u0006\u0010 \u001a\u00020!H\u0087\u0002\u00a2\u0006\u0002\u0008#\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020$0*2\u0006\u0010 \u001a\u00020!H\u0087\u0002\u00a2\u0006\u0002\u0008%\u001a\u0015\u0010\u0019\u001a\u00020\u001a*\u00020\u000e2\u0006\u0010 \u001a\u00020!H\u0087\n\u001a\u0015\u0010\u0019\u001a\u00020\u001a*\u00020\u000f2\u0006\u0010 \u001a\u00020!H\u0087\n\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00010\u001f2\u0006\u0010 \u001a\u00020&H\u0087\u0002\u00a2\u0006\u0002\u0008\"\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00030\u001f2\u0006\u0010 \u001a\u00020&H\u0087\u0002\u00a2\u0006\u0002\u0008#\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020!0\u001f2\u0006\u0010 \u001a\u00020&H\u0087\u0002\u00a2\u0006\u0002\u0008+\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020$0\u001f2\u0006\u0010 \u001a\u00020&H\u0087\u0002\u00a2\u0006\u0002\u0008%\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020(0\u001f2\u0006\u0010 \u001a\u00020&H\u0087\u0002\u00a2\u0006\u0002\u0008)\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00010\u001f2\u0006\u0010 \u001a\u00020(H\u0087\u0002\u00a2\u0006\u0002\u0008\"\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00030\u001f2\u0006\u0010 \u001a\u00020(H\u0087\u0002\u00a2\u0006\u0002\u0008#\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020!0\u001f2\u0006\u0010 \u001a\u00020(H\u0087\u0002\u00a2\u0006\u0002\u0008+\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020$0\u001f2\u0006\u0010 \u001a\u00020(H\u0087\u0002\u00a2\u0006\u0002\u0008%\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020&0\u001f2\u0006\u0010 \u001a\u00020(H\u0087\u0002\u00a2\u0006\u0002\u0008\'\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020&0*2\u0006\u0010 \u001a\u00020(H\u0087\u0002\u00a2\u0006\u0002\u0008\'\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00030\u001f2\u0006\u0010 \u001a\u00020\u0001H\u0087\u0002\u00a2\u0006\u0002\u0008#\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020!0\u001f2\u0006\u0010 \u001a\u00020\u0001H\u0087\u0002\u00a2\u0006\u0002\u0008+\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020$0\u001f2\u0006\u0010 \u001a\u00020\u0001H\u0087\u0002\u00a2\u0006\u0002\u0008%\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020&0\u001f2\u0006\u0010 \u001a\u00020\u0001H\u0087\u0002\u00a2\u0006\u0002\u0008\'\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020(0\u001f2\u0006\u0010 \u001a\u00020\u0001H\u0087\u0002\u00a2\u0006\u0002\u0008)\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00030*2\u0006\u0010 \u001a\u00020\u0001H\u0087\u0002\u00a2\u0006\u0002\u0008#\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020!0*2\u0006\u0010 \u001a\u00020\u0001H\u0087\u0002\u00a2\u0006\u0002\u0008+\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020$0*2\u0006\u0010 \u001a\u00020\u0001H\u0087\u0002\u00a2\u0006\u0002\u0008%\u001a\u0015\u0010\u0019\u001a\u00020\u001a*\u00020\u000f2\u0006\u0010 \u001a\u00020\u0001H\u0087\n\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00010\u001f2\u0006\u0010 \u001a\u00020\u0003H\u0087\u0002\u00a2\u0006\u0002\u0008\"\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020!0\u001f2\u0006\u0010 \u001a\u00020\u0003H\u0087\u0002\u00a2\u0006\u0002\u0008+\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020$0\u001f2\u0006\u0010 \u001a\u00020\u0003H\u0087\u0002\u00a2\u0006\u0002\u0008%\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020&0\u001f2\u0006\u0010 \u001a\u00020\u0003H\u0087\u0002\u00a2\u0006\u0002\u0008\'\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020(0\u001f2\u0006\u0010 \u001a\u00020\u0003H\u0087\u0002\u00a2\u0006\u0002\u0008)\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00010*2\u0006\u0010 \u001a\u00020\u0003H\u0087\u0002\u00a2\u0006\u0002\u0008\"\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020!0*2\u0006\u0010 \u001a\u00020\u0003H\u0087\u0002\u00a2\u0006\u0002\u0008+\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020$0*2\u0006\u0010 \u001a\u00020\u0003H\u0087\u0002\u00a2\u0006\u0002\u0008%\u001a\u0015\u0010\u0019\u001a\u00020\u001a*\u00020\u000e2\u0006\u0010 \u001a\u00020\u0003H\u0087\n\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00010\u001f2\u0006\u0010 \u001a\u00020$H\u0087\u0002\u00a2\u0006\u0002\u0008\"\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00030\u001f2\u0006\u0010 \u001a\u00020$H\u0087\u0002\u00a2\u0006\u0002\u0008#\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020!0\u001f2\u0006\u0010 \u001a\u00020$H\u0087\u0002\u00a2\u0006\u0002\u0008+\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020&0\u001f2\u0006\u0010 \u001a\u00020$H\u0087\u0002\u00a2\u0006\u0002\u0008\'\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020(0\u001f2\u0006\u0010 \u001a\u00020$H\u0087\u0002\u00a2\u0006\u0002\u0008)\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00010*2\u0006\u0010 \u001a\u00020$H\u0087\u0002\u00a2\u0006\u0002\u0008\"\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020\u00030*2\u0006\u0010 \u001a\u00020$H\u0087\u0002\u00a2\u0006\u0002\u0008#\u001a \u0010\u0019\u001a\u00020\u001a*\u0008\u0012\u0004\u0012\u00020!0*2\u0006\u0010 \u001a\u00020$H\u0087\u0002\u00a2\u0006\u0002\u0008+\u001a\u0015\u0010\u0019\u001a\u00020\u001a*\u00020\u000e2\u0006\u0010 \u001a\u