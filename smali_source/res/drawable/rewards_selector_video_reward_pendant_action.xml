<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#ffff7b81" />
            <corners android:radius="17.0dip" />
        </shape>
    </item>
    <item android:state_enabled="true">
        <shape>
            <gradient android:startColor="#ffffb800" android:endColor="#fff418ef" android:angle="0.0" android:centerColor="#ffff2d3f" />
            <corners android:radius="17.0dip" />
        </shape>
    </item>
</selector>