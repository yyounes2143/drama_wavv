<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:left="0.5dip" android:top="0.5dip" android:right="0.5dip" android:bottom="0.5dip">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#ff240e05" android:endColor="#ff000000" android:angle="0.0" android:type="linear" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1.0dip" android:color="#ffff7c4e" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="0.5dip" android:top="0.5dip" android:right="0.5dip" android:bottom="0.5dip">
                <shape android:shape="rectangle">
                    <gradient android:startColor="#ff240e05" android:endColor="#ff000000" android:angle="0.0" android:type="linear" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="0.5dip" android:color="@color/theme_line1" />
                    <corners android:radius="8.0dip" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>