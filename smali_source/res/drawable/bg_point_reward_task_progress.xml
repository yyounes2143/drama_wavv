<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_8sdp" />
            <solid android:color="#14ffffff" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:gravity="start" android:clipOrientation="horizontal">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/_8sdp" />
                <gradient android:startColor="#ffeba739" android:endColor="#fffbd474" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>