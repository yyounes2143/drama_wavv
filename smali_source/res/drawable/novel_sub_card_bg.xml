<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#26ffab0f" />
            <corners android:radius="@dimen/_8sdp" />
            <stroke android:width="@dimen/_2sdp" android:color="#ffffab0f" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0fffab0f" />
            <corners android:radius="@dimen/_8sdp" />
            <stroke android:width="@dimen/_1sdp" android:color="#80ffab0f" />
        </shape>
    </item>
</selector>