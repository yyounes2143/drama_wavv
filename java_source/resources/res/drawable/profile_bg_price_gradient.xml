<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#d9a959"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#e9a131"
                android:endColor="#fdd779"
                android:angle="90"
                android:type="linear"
                android:centerY="0.5"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
</layer-list>
