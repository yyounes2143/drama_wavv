<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item
                android:left="0.5dp"
                android:top="0.5dp"
                android:right="0.5dp"
                android:bottom="0.5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#240e05"
                        android:endColor="#000"
                        android:angle="0"
                        android:type="linear"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="#ff7c4e"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item
                android:left="0.5dp"
                android:top="0.5dp"
                android:right="0.5dp"
                android:bottom="0.5dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#240e05"
                        android:endColor="#000"
                        android:angle="0"
                        android:type="linear"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="0.5dp"
                        android:color="@color/theme_line1"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
