<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/common_shape_conner_12_top_surface_3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/theme_surface3">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/theme_text1"
        android:gravity="center"
        android:id="@+id/tv_message"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/delete_all_history_tips"
        android:paddingVertical="20dp"/>
    <View
        android:id="@+id/view1"
        android:background="@color/theme_line2"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_message"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/theme_brand6"
        android:gravity="center"
        android:id="@+id/tv_confirm"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toBottomOf="@+id/view1"/>
    <View
        android:id="@+id/view2"
        android:background="@color/theme_surface2"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_confirm"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/theme_text1"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel_up"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toBottomOf="@+id/view2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
