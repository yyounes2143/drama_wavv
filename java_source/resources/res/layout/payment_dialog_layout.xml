<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_overlay_container"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_overlay_click_area"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.dramawave.shared.p448ui.view.MaxHeightFrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/maxHeightContainer"
        android:background="@drawable/common_shape_top_conner_12_surface_1"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siv_purchase_header_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/payment_dialog_bg"
            android:scaleType="fitXY"
            android:contentDescription="@string/mine_empty"
            app:shapeAppearance="@style/home_roundedStyle_top_rounded_12"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/layoutHeaderContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:layout_weight="1">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutComponentContainer"
                    android:paddingLeft="@dimen/_16sdp"
                    android:paddingRight="@dimen/_16sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_16sdp"/>
            </androidx.core.widget.NestedScrollView>
            <FrameLayout
                android:id="@+id/layoutFooterContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_2sdp"/>
        </LinearLayout>
    </com.dramawave.shared.p448ui.view.MaxHeightFrameLayout>
</FrameLayout>
