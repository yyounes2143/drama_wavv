<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="#cc000000"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tp_tx_appname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="App Name"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#b2000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="We care about your privacy and data security. We keep this app free by showing ads."/>
        <TextView
            android:textSize="18sp"
            android:textColor="@android:color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="Can we continue to use your data to tailor ads for you?"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#b2000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:text="You can change your choice anytime forYou can change your choice anytime forYou can change your choice anytime forYou can change your choice anytime for "/>
        <TextView
            android:textSize="12sp"
            android:textColor="#1a73e8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:text="Ynge your choice anytime fore anytime for "/>
    </LinearLayout>
</LinearLayout>
