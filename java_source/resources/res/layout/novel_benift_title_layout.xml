<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_divider_left"
        android:background="@drawable/novel_benefit_title_divider_left"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_2sdp"/>
    <TextView
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/reader_style_0_text_primary"
        android:id="@+id/tv_benefit_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_8sdp"
        android:layout_marginRight="@dimen/_8sdp"
        android:text="@string/novel_sub_dialog_benefit_title"
        android:includeFontPadding="false"
        android:layout_marginHorizontal="@dimen/_8sdp"/>
    <View
        android:id="@+id/view_divider_right"
        android:background="@drawable/novel_benefit_title_divider_right"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_2sdp"/>
</LinearLayout>
