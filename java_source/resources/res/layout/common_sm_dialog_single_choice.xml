<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:id="@+id/common_header_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/common_text_color_9197A3"
        android:id="@+id/common_dialog_title"
        android:paddingTop="12dp"
        android:paddingBottom="2dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
    <FrameLayout
        android:id="@+id/lyt_custom_title_wrap"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:overScrollMode="never"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/theme_text3"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/common_dialog_btn_negative"
        android:background="@drawable/common_btn_dialog_gray"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/mine_dialog_logout_cancel"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
</LinearLayout>
