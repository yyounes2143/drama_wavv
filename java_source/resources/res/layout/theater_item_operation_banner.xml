<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/_20sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_12sdp">
    <com.youth.banner.Banner
        android:id="@+id/operation_banner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:banner_indicator_gravity="center"
        app:banner_indicator_margin="@dimen/_4sdp"
        app:banner_indicator_marginBottom="@dimen/_12sdp"
        app:banner_indicator_normal_color="#ffffff"
        app:banner_indicator_normal_width="@dimen/_4sdp"
        app:banner_indicator_selected_color="#ffffff"
        app:banner_indicator_selected_width="@dimen/_8sdp"
        app:layout_constraintDimensionRatio="4:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
