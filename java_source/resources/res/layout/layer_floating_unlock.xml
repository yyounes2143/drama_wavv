<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/_96sdp"
    android:layout_marginStart="@dimen/_16sdp">
    <FrameLayout
        android:layout_gravity="bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_7sdp">
            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/_50sdp"
                android:layout_height="@dimen/_66sdp"
                android:elevation="@dimen/_2sdp"
                app:cardBackgroundColor="@color/transparent"
                app:cardCornerRadius="@dimen/_4sdp">
                <com.dramawave.shared.p448ui.view.EnhancedImageView
                    android:id="@+id/iv_cover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:ei_ratio="1.34"/>
            </androidx.cardview.widget.CardView>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp">
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/theme_text1"
                    android:ellipsize="end"
                    android:id="@+id/tv_float_title"
                    android:padding="0dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:maxWidth="@dimen/_208sdp"
                    android:maxLines="2"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"/>
                <TextView
                    android:textSize="@dimen/_12sdp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text5"
                    android:gravity="center"
                    android:id="@+id/tv_float_price"
                    android:background="@drawable/float_btn_bg"
                    android:paddingLeft="@dimen/_8sdp"
                    android:paddingTop="@dimen/_3sdp"
                    android:paddingRight="@dimen/_8sdp"
                    android:paddingBottom="@dimen/_3sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_3sdp"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/iv_float_close"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/ic_float_unlock_close"
                android:layout_marginStart="@dimen/_4sdp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/_6sdp"
            android:textStyle="bold"
            android:textColor="@color/theme_text9"
            android:id="@+id/tv_float_off_tag"
            android:background="@drawable/bg_float_tag_off"
            android:paddingLeft="@dimen/_4sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingRight="@dimen/_4sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_4sdp"
            android:paddingVertical="@dimen/_2sdp"/>
    </FrameLayout>
</FrameLayout>
