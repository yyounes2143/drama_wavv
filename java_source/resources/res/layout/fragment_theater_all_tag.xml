<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/common_shape_conner_12_top_surface_3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#2e2f30">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/sr_category"
        android:layout_marginStart="12dp"/>
    <com.dramawave.core.common.view.MaxHeightRecyclerView
        android:id="@+id/recycle_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:overScrollMode="never"
        app:maxHeight="300dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_bottom"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="8dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_reset"
            android:background="@drawable/common_shape_conner_8_white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/reset"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_4sdp"
            android:backgroundTint="#434546"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/theme_text5"
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:background="@drawable/common_shape_conner_8_white"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/confirm"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            android:backgroundTint="#fc2763"/>
    </LinearLayout>
</LinearLayout>
