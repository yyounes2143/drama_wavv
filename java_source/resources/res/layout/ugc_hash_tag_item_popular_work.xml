<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:paddingTop="@dimen/_4sdp"
    android:paddingBottom="@dimen/_12sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_12sdp">
    <ImageView
        android:id="@+id/iv_cover"
        android:layout_width="@dimen/_90sdp"
        android:layout_height="@dimen/_120sdp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_cover"
        app:layout_constraintTop_toTopOf="@+id/iv_cover">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/ugc_text_1"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/ugc_text_3"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:maxLines="3"
            android:textAlignment="viewStart"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_2sdp"
        android:layout_marginStart="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_cover">
        <ImageView
            android:id="@+id/iv_author"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:foreground="@drawable/ugc_topic_avatar_stroke"/>
        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_4sdp"
            app:alignItems="center"
            app:flexWrap="nowrap">
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/ugc_text_3"
                android:ellipsize="end"
                android:gravity="start"
                android:id="@+id/tv_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="viewStart"
                app:layout_flexShrink="1"/>
            <ImageView
                android:id="@+id/iv_verification"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_marginStart="@dimen/_2sdp"
                app:layout_flexShrink="0"/>
        </com.google.android.flexbox.FlexboxLayout>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/ugc_text_3"
            android:gravity="center_vertical"
            android:id="@+id/tv_play_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/_4sdp"
            android:layout_marginStart="@dimen/_12sdp"
            app:drawableStartCompat="@drawable/ic_ugc_topic_popular_works_play"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/ugc_text_3"
            android:gravity="center_vertical"
            android:id="@+id/tv_like_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/_4sdp"
            android:layout_marginStart="@dimen/_12sdp"
            app:drawableStartCompat="@drawable/ic_ugc_topic_popular_works_heart"/>
        <ImageView
            android:id="@+id/iv_more"
            android:visibility="gone"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ugc_ic_more"
            android:layout_marginStart="@dimen/_12sdp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
