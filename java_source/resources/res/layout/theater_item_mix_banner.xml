<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/_4sdp"
    android:paddingTop="@dimen/_4sdp"
    android:paddingRight="@dimen/_4sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_4sdp">
    <com.dramawave.shared.p448ui.view.looppager.LoopViewPager
        android:id="@+id/header_banner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="351:198"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.dramawave.shared.p448ui.view.indicator.CustomIndicatorView
        android:id="@+id/indicator"
        android:background="@drawable/common_shape_conner_8_white_20"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:selected_drawable="@drawable/common_shape_conner_8_white"
        app:selected_drawable_height="match_parent"
        app:selected_drawable_width="match_parent"
        app:unselect_drawable="@color/transparent"
        app:unselect_drawable_height="match_parent"
        app:unselect_drawable_width="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
