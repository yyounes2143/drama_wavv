<?xml version="1.0" encoding="utf-8"?>
<com.dramawave.shared.p448ui.view.banner.SwipeDismissLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/in_app_push_banner"
    android:background="@drawable/common_shape_conner_8_surface_4"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_12sdp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/_41sdp"
    android:importantForAccessibility="yes"
    android:paddingStart="@dimen/_16sdp"
    android:paddingEnd="@dimen/_16sdp"
    android:elevation="@dimen/_12sdp">
    <TextView
        android:textSize="14sp"
        android:textColor="@color/theme_text1"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/in_app_push_banner_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:layout_marginEnd="@dimen/_12sdp"
        android:letterSpacing="0"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/in_app_push_banner_action"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/theme_brand6"
            android:id="@+id/in_app_push_banner_action_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            android:letterSpacing="0"/>
        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_chevron_right_brand6_automirror"
            android:importantForAccessibility="no"/>
    </LinearLayout>
</com.dramawave.shared.p448ui.view.banner.SwipeDismissLinearLayout>
