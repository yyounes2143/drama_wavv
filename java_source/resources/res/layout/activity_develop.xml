<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tlb_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="开发测试页面"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.dramawave.feature.develop.view.DevelopGroupView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:title="应用信息"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="版本信息"
                android:textIsSelectable="true"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_userid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="用户ID"
                android:textIsSelectable="true"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_deviceid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="设备ID"
                android:textIsSelectable="true"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_device_perf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="设备性能"
                android:textIsSelectable="true"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_device_cpu_perf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="性能评分cpu"
                android:textIsSelectable="true"/>
            <EditText
                android:textColor="@color/white"
                android:textColorHint="#cccccc"
                android:id="@+id/et_web_view_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="测试url"
                android:singleLine="true"
                android:focusedByDefault="false"/>
            <com.dramawave.feature.develop.view.DevelopGroupView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:title="@string/dev_env_switch_group"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_current_env"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/dev_current_env"
                android:textIsSelectable="true"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_env_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/dev_target_env"
                android:selectable="true"/>
            <com.dramawave.feature.develop.view.DevelopGroupView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:title="API服务器相关测试"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_is_china"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="是否是中国国行版本"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_quic_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:title="QUIC开关"
                android:checkable="true"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_controller_reset_on_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:title="Controller RestOnError"
                android:checkable="true"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_quic_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="print QUIC统计信息"
                android:textIsSelectable="true"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_router"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试路由跳转"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_ugc_my_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试 我的UGC作品列表"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_ads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试广告"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:value="解决低端机型WebView问题"
                android:id="@+id/dev_test_ads_no_hardware_accel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试广告(禁用硬件加速)"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_ump"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试ump"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_coming_soon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试ComingSoon"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_im"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试im"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试ChatActivity"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_get_gaid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试获取gaid"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_bus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试EventBus"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_web_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试WebPage"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_h5_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试H5 URL列表"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_analytics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试打点"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_analytics_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试打点-立即"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_remote_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试RemoteConfig"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_share_series"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试分享Series"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_pick_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试PickImage"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_camera"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试camera"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试图片"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_video_player"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试播放器"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_video_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试播放器列表"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试字幕"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_dialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试弹窗"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_viewmodel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试全局 ViewModel"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试Seekbar"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_video_range_selector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试视频区间选择器"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_notification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试Notification"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_in_app_push_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/dev_test_in_app_push_banner"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_simulate_ugc_push"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/dev_simulate_ugc_push"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_simulate_fsi_push"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/dev_simulate_fsi_push"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_custom_in_app_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="@string/dev_test_custom_in_app_banner"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_preload_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试使用本地字幕功能"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_simple_web_page"
                android:layout_width="match_parent"
