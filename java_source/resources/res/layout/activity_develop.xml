                android:title="测试SimpleWebPage"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_jump_google_play_subs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试跳转Google订阅中心"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_crash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试崩溃"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_video_download"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试视频下载Page"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_video_local_play"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试视频下载播放Page"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_root"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试root"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_actor_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试演员排行榜"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_deeplink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试Deeplink处理"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试日历写事件"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_print_thread"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="打印线程情况"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_strings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试字符串格式化"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_full_screen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试全屏Intent"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_open_schema"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试Open Scehma"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_test_common_dialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="测试通用弹窗Activity"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/enable_video_cdn_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:title="是否启用视频cdn切换"
                android:checkable="true"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_level_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="设置设备性能值为1"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_level_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="设置设备性能值为2"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_level_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="设置设备性能值为3"/>
            <com.dramawave.feature.develop.view.DevelopEntryView
                android:id="@+id/dev_level_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:title="设置设备性能值为4"/>
