<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/_3sdp"
    android:layout_marginRight="@dimen/_3sdp"
    android:layout_marginHorizontal="@dimen/_3sdp">
    <com.dramawave.shared.general.view.SeriesCoverView
        android:id="@+id/igv_cover"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/_112sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:operatorTagRightMargin="24dp"
        app:operatorTagRightPosition="false"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/theme_text1"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="38sp"
        android:layout_marginTop="@dimen/_6sdp"
        android:maxLines="2"
        android:minLines="2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/igv_cover"/>
    <TextView
        android:textColor="@color/theme_text1"
        android:ellipsize="end"
        android:id="@+id/tv_episode"
        android:paddingBottom="@dimen/_20sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:singleLine="true"
        android:alpha="0.4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_name"
        style="@style/theme_TextRegular12"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_follow"
        android:background="@drawable/shape_conner_tr_8_bl_4"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_follow"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/ic_detail_follow_gray"/>
    </LinearLayout>
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:background="@drawable/bg_corner_4_black_75"
        android:paddingLeft="@dimen/_4sdp"
        android:paddingTop="@dimen/_2sdp"
        android:paddingRight="@dimen/_4sdp"
        android:paddingBottom="@dimen/_2sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_3sdp"
        android:layout_marginEnd="@dimen/_3sdp"
        android:paddingHorizontal="@dimen/_4sdp"
        android:paddingVertical="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="@+id/igv_cover"
        app:layout_constraintEnd_toEndOf="@+id/igv_cover">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_bottom_hot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/iv_hot"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:src="@drawable/ic_fire_grey"/>
            <TextView
                android:textColor="@color/theme_text2"
                android:gravity="center_vertical"
                android:id="@+id/tv_hot_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/theme_TextRegular10"/>
        </LinearLayout>
    </eightbitlab.com.blurview.BlurView>
</androidx.constraintlayout.widget.ConstraintLayout>
