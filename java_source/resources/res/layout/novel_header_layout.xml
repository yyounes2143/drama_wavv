<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.dramawave.feature.novel.view.NovelHeaderRightView
        android:id="@+id/novel_header_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:textColor="?attr/reader_text_secondary"
        android:ellipsize="end"
        android:id="@+id/novel_header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:includeFontPadding="false"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/novel_header_right"/>
</RelativeLayout>
