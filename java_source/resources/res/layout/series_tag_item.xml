<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/theme_text3"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_episode_tag"
        android:background="@drawable/common_shape_conner_4_fill2"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_18sdp"
        android:layout_marginBottom="8dp"
        android:maxLines="1"
        android:lineSpacingExtra="0dp"
        android:layout_marginEnd="8dp"
        android:paddingHorizontal="8dp"
        app:drawableEndCompat="@drawable/ic_check_arrow_right_automirror"
        style="@style/theme_TextRegular12"/>
</LinearLayout>
