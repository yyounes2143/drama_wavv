<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="1dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tp_ll_ad_choices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tp_ll_nativebanner"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/tp_native_icon_image"
                android:visibility="visible"
                android:layout_width="50dp"
                android:layout_height="50dp"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="4dp"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:id="@+id/tp_native_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lines="1"/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:ellipsize="end"
                android:id="@+id/tp_native_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:lines="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:background="@drawable/tp_ad"
                    android:layout_width="12dp"
                    android:layout_height="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tp_star_container"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RatingBar
                    android:id="@+id/tp_native_star"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:rating="3.5"
                    android:stepSize="0.5"
                    android:isIndicator="true"
                    style="?android:attr/ratingBarStyleSmall"/>
                <TextView
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:id="@+id/tp_star_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5.0"
                    android:lines="1"/>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/tp_native_main_image"
            android:layout_width="80dp"
            android:layout_height="50dp"
            android:layout_below="@+id/tp_native_text"
            android:layout_alignParentLeft="true">
            <ImageView
                android:id="@+id/tp_mopub_native_main_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
        <RelativeLayout
            android:background="#4286f4"
            android:layout_width="60dp"
            android:layout_height="50dp">
            <ImageView
                android:id="@+id/tp_native_ad_choice"
                android:paddingTop="2dp"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_alignParentTop="true"
                android:paddingEnd="2dp"
                android:layout_alignParentEnd="true"/>
            <FrameLayout
                android:id="@+id/tp_ad_choices_container"
                android:paddingTop="2dp"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"/>
            <Button
                android:textSize="12sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/tp_native_cta_btn"
                android:background="#00000000"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:visibility="visible"
                android:layout_width="60dp"
                android:layout_height="50dp"
                android:text="Learn More"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
