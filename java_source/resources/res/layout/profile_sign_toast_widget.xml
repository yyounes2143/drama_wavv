<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sign_toast_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_35sdp">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/notice_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <com.dramawave.shared.p448ui.view.TriangleView
            android:layout_gravity="end"
            android:id="@+id/triangleUp"
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_26sdp"
            app:paintingStyle="fill"
            app:triangleColor="@color/theme_brand6"
            app:triangleDirection="up"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/notice_background"
            android:background="@drawable/rounded_bg"
            android:paddingTop="@dimen/_4sdp"
            android:paddingBottom="@dimen/_4sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_7sdp"
            android:layout_marginBottom="@dimen/_6sdp"
            android:paddingStart="@dimen/_8sdp"
            android:paddingEnd="@dimen/_24sdp">
            <TextView
                android:textSize="@dimen/text_size_10"
                android:textColor="@color/theme_text1"
                android:id="@+id/notice_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_login_rewards"/>
        </LinearLayout>
        <com.dramawave.shared.p448ui.view.TriangleView
            android:layout_gravity="end|bottom"
            android:id="@+id/triangleDown"
            android:visibility="gone"
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_26sdp"
            app:paintingStyle="fill"
            app:triangleColor="@color/theme_brand6"
            app:triangleDirection="down"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/overlay_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_size_10"
            android:textColor="@android:color/transparent"
            android:id="@+id/placeholder_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_login_rewards"/>
        <View
            android:id="@+id/spacer"
            android:layout_width="@dimen/_15sdp"
            android:layout_height="0dp"/>
        <ImageView
            android:id="@+id/icon_task_login_profile"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:src="@drawable/ic_profile_task_login"/>
    </LinearLayout>
</FrameLayout>
