<?xml version="1.0" encoding="utf-8"?>
<com.dramawave.feature.profile.view.ShadowClipConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_12sdp"
    app:shadowRlRadius="@dimen/_8sdp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_content"
        android:background="@drawable/profile_selector_vip_center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="@dimen/_16sdp"
            android:paddingBottom="@dimen/_16sdp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingEnd="@dimen/_12sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:paddingVertical="@dimen/_16sdp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                app:layout_constraintEnd_toStartOf="@+id/ll_price"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/iv_vip_icon"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:src="@drawable/profile_ic_vip_icon"
                        android:layout_marginEnd="@dimen/_4sdp"/>
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/theme_text12"
                        android:ellipsize="end"
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/theme_text2"
                    android:ellipsize="end"
                    android:id="@+id/tv_description"
                    android:paddingLeft="@dimen/_2sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:maxLines="2"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/theme_text2"
                    android:id="@+id/tv_discount_desc"
                    android:paddingLeft="@dimen/_2sdp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="@color/theme_text8"
                    android:id="@+id/tv_tips"
                    android:paddingLeft="@dimen/_2sdp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:maxLines="2"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/theme_text10"
                    android:gravity="center"
                    android:id="@+id/tv_price"
                    android:background="@drawable/profile_bg_price_gradient"
                    android:paddingLeft="@dimen/_4sdp"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingRight="@dimen/_4sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_4sdp"
                    android:paddingVertical="@dimen/_8sdp"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/theme_text2"
                    android:layout_gravity="center"
                    android:id="@+id/tv_original_price"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily=""/>
            </LinearLayout>
            <TextView
                android:textSize="@dimen/text_size_10"
                android:textColor="@color/theme_text10"
                android:id="@+id/tv_tag"
                android:background="@drawable/profile_bg_vip_package_tag"
                android:paddingLeft="@dimen/_8sdp"
                android:paddingTop="@dimen/_2sdp"
                android:paddingRight="@dimen/_8sdp"
                android:paddingBottom="@dimen/_2sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_2sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.dramawave.shared.p448ui.view.SweepView
            android:id="@+id/sweep_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_vip_pro_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/_35sdp"
        android:layout_marginRight="@dimen/_35sdp"
        android:src="@drawable/common_vip_pro_light"
        android:alpha="0.4"
        android:layout_marginHorizontal="@dimen/_35sdp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.dramawave.feature.profile.view.PurchaseSelectedView
        android:id="@+id/psv_vip_selected"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/profile_bg_vip_center_scan"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.dramawave.feature.profile.view.ShadowClipConstraintLayout>
