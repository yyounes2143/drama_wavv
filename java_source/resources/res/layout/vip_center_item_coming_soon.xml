<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_date_container"
        android:layout_width="@dimen/_131sdp"
        android:layout_height="@dimen/_20sdp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_date_icon"
            android:visibility="gone"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/profile_ic_date"/>
        <Space
            android:layout_gravity="center_vertical"
            android:id="@+id/space_before_text"
            android:visibility="gone"
            android:layout_width="@dimen/_4sdp"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:textColor="@color/theme_text2"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Space
            android:layout_gravity="center_vertical"
            android:id="@+id/space_after_text"
            android:visibility="gone"
            android:layout_width="@dimen/_4sdp"
            android:layout_height="wrap_content"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/view_date_line"
            android:background="@color/theme_line2"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:layout_weight="1"/>
        <Space
            android:id="@+id/space_end"
            android:visibility="gone"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/_123sdp"
        android:layout_height="@dimen/_164sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        app:cardCornerRadius="@dimen/_8sdp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/iv_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.cardview.widget.CardView>
    <TextView
        android:textSize="@dimen/_13sdp"
        android:textColor="@color/theme_text1"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:minHeight="@dimen/_36sdp"
        android:maxLines="2"
        android:layout_marginEnd="@dimen/_8sdp"/>
</LinearLayout>
