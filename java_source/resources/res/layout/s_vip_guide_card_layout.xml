<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_subscribe_vip"
        android:background="@drawable/bg_common_vip_not_subscribe"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp">
        <ImageView
            android:id="@+id/iv_vip_icon"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:src="@drawable/ic_vip_badge"
            android:contentDescription="@string/mine_empty"
            android:layout_marginStart="@dimen/_12sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/theme_text10"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/_36sdp"
            android:text="@string/vip_center_page_card"
            android:maxLines="2"
            android:lineSpacingMultiplier="1"
            android:layout_marginStart="@dimen/_4sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_vip_icon"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_vip_benefits"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:paddingStart="@dimen/_16sdp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/iv_vip_icon"/>
        <RelativeLayout
            android:id="@+id/rl_enter"
            android:background="@drawable/bg_common_vip_subscribe_active"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:layout_marginRight="@dimen/_12sdp"
            android:layout_marginHorizontal="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rv_vip_benefits">
            <TextView
                android:textStyle="bold"
                android:textColor="@color/theme_text10"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/btn_become_vip"
                android:paddingLeft="@dimen/_4sdp"
                android:paddingTop="@dimen/_8sdp"
                android:paddingRight="@dimen/_4sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_vip_activate_arrow"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:drawablePadding="@dimen/_2sdp"
                android:layout_centerHorizontal="true"
                android:lineSpacingMultiplier="1"
                android:textAlignment="center"
                android:paddingHorizontal="@dimen/_4sdp"
                android:paddingVertical="@dimen/_8sdp"/>
            <FrameLayout
                android:id="@+id/fl_right"
                android:background="@drawable/ic_common_vip_top_right_automirror"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text9"
                    android:gravity="center"
                    android:id="@+id/tv_first_discount"
                    android:paddingLeft="@dimen/_8sdp"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingRight="@dimen/_8sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="@dimen/_2sdp"/>
            </FrameLayout>
        </RelativeLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/theme_text11"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_bottom_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:layout_marginRight="@dimen/_12sdp"
            android:maxLines="2"
            android:lineSpacingMultiplier="1"
            android:layout_marginEnd="@dimen/_4sdp"
            android:layout_marginHorizontal="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rl_enter"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/theme_text10"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_amount"
            android:paddingLeft="@dimen/_4sdp"
            android:paddingRight="@dimen/_4sdp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="$19"
            android:maxLines="2"
            android:lineSpacingMultiplier="1"
            android:paddingHorizontal="@dimen/_4sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_bottom_text"
            app:layout_constraintTop_toBottomOf="@+id/rl_enter"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
