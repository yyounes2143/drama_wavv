<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_toast_vip"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_16sdp"
    android:paddingVertical="8dp">
    <ImageView
        android:layout_gravity="center_vertical"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:src="@mipmap/ic_crown"/>
    <com.dramawave.core.common.view.GradientTextView
        android:textSize="@dimen/_14sdp"
        android:textStyle="bold"
        android:layout_gravity="center_vertical"
        android:id="@android:id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_4sdp"
        app:gradientDirection="left_to_right"
        app:gradientEndColor="#f1b132"
        app:gradientMiddleColor="#ffdd8a"
        app:gradientStartColor="#f1b132"/>
</LinearLayout>
