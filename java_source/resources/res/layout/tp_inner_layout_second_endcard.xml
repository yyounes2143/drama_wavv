<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#b2000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/tp_inner_layout_second_endcard"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.p547tp.adx.sdk.p548ui.views.InnerRoundAngleImageView
                android:id="@+id/tp_inner_img_endcard_icon"
                android:layout_width="80dp"
                android:layout_height="80dp"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@android:color/white"
                android:id="@+id/tp_inner_tv_endcard_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Test App Name"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_margin="15dp">
                <Button
                    android:textSize="18sp"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:id="@+id/tp_inner_btn_endcard_close_mid"
                    android:background="@drawable/tp_inner_bg_btn_close"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Close"
                    android:textAllCaps="false"/>
                <Button
                    android:textSize="18sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/tp_inner_btn_endcard_get"
                    android:background="@drawable/tp_inner_bg_btn_get"
                    android:layout_width="180dp"
                    android:layout_height="match_parent"
                    android:text="GET"
                    android:layout_centerHorizontal="true"/>
            </RelativeLayout>
        </LinearLayout>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/tp_inner_btn_endcard_close"
            android:background="@drawable/tp_inner_cover_close"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="10dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tp_ad_flag"
            android:background="@drawable/tp_inner_bg_countdown"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="14dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="AD"
            android:layout_marginStart="10dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"/>
    </FrameLayout>
</LinearLayout>
