<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_package"
        android:background="@drawable/payment_bg_recharge_pk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:paddingStart="@dimen/_12sdp"
        app:layout_constraintTop_toBottomOf="@+id/rv_memberships">
        <include
            android:id="@+id/include_purchase_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/purchase_tag_layout"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/theme_text1"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_unlock_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/profile_unlock_package_name"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/img_small_coin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/theme_TextBold14"/>
        <ImageView
            android:id="@+id/img_small_coin"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:layout_marginTop="16dp"
            android:src="@drawable/ic_common_coin_single"
            android:contentDescription="@string/mine_empty"
            android:layout_marginEnd="@dimen/_2sdp"
            app:layout_constraintEnd_toStartOf="@+id/tv_discount_price"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_discount_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textAlignment="center"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/img_small_coin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/img_small_coin"/>
        <TextView
            android:textColor="@color/theme_text2"
            android:gravity="center"
            android:id="@+id/tv_original_price"
            android:paddingBottom="@dimen/_20sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:textAlignment="center"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="@+id/tv_discount_price"
            app:layout_constraintStart_toStartOf="@+id/tv_discount_price"
            app:layout_constraintTop_toBottomOf="@+id/img_small_coin"
            style="@style/theme_TextRegular12"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
