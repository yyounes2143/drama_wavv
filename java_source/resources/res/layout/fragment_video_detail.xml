<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dramawave.shared.p448ui.view.content.ContentContainer
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.dramawave.shared.player.view.DirectionalVideoPager
            android:id="@+id/video_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/fl_video_reward_pendant_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/fl_video_coin_pendant_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/fl_zero_gift_pendant_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:id="@+id/kocr_auth_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.dramawave.shared.p448ui.view.content.ContentContainer>
    <FrameLayout
        android:id="@+id/view_block"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:nestedScrollingEnabled="true">
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nestedScrollingEnabled="true"/>
        <View
            android:layout_gravity="end"
            android:id="@+id/right_pan"
            android:layout_width="80dp"
            android:layout_height="match_parent"/>
        <View
            android:layout_gravity="bottom"
            android:id="@+id/bottom_pan"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv_back"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingRight="@dimen/_16sdp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/_44sdp"
        android:src="@drawable/ic_back_left"
        android:nestedScrollingEnabled="true"
        android:paddingHorizontal="@dimen/_16sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ViewStub
        android:id="@+id/danmaku_view_stub"
        android:layout="@layout/layout_danmu_view"
        android:inflatedId="@+id/danmaku_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_400sdp"
        android:layout_marginTop="@dimen/_90sdp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.dramawave.feature.home.detail.widget.CompliantView
        android:id="@+id/compliant_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
