<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_common_left_conner_12_b90"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:id="@+id/ll_menu_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/v_top_mar"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_header"
            android:paddingLeft="16dp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingRight="16dp"
            android:paddingBottom="@dimen/_10sdp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="@dimen/_10sdp">
            <View
                android:id="@+id/v_extra"
                android:visibility="gone"
                android:layout_width="@dimen/_6sdp"
                android:layout_height="@dimen/_10sdp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/theme_text1"
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_close"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_close_landscape"
                android:scaleType="centerInside"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/fl_custom_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/view_divider"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <FrameLayout
            android:id="@+id/fl_custom_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_menu"
            android:paddingBottom="@dimen/_24sdp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>
</FrameLayout>
