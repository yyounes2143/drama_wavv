<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/_40sdp"
    android:paddingRight="@dimen/_40sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_40sdp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_layout"
        android:background="@drawable/login_rewards_dialog_bg"
        android:paddingBottom="@dimen/_24sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <com.dramawave.shared.base.dialog.alert.RoundImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_rewards_dialog_welfare_bg_auto_mirrored"
            app:layout_constraintTop_toTopOf="parent"
            app:leftTop_corner_radius="@dimen/_12sdp"
            app:rightTop_corner_radius="@dimen/_12sdp"
            app:type="radial"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text9"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:text="@string/sr_to_cancel_log_in"
            android:maxLines="2"
            android:layout_marginHorizontal="@dimen/_16sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/theme_text9"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="@string/sr_after_log_in"
            android:maxLines="2"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="@dimen/_16sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <ImageView
            android:id="@+id/iv_gold_icon"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:src="@drawable/ic_login_diamonds"
            android:layout_marginEnd="3dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_reward_content"
            app:layout_constraintEnd_toStartOf="@+id/tv_reward_content"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_reward_content"/>
        <TextView
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/theme_brand6"
            android:gravity="center"
            android:id="@+id/tv_reward_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            app:layout_constraintBottom_toTopOf="@+id/iv_icon"
            app:layout_constraintEnd_toStartOf="@+id/tv_reward_content_rp"
            app:layout_constraintStart_toEndOf="@+id/iv_gold_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_sub_title"/>
        <TextView
            android:textColor="@color/theme_text9"
            android:gravity="center"
            android:id="@+id/tv_reward_content_rp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_4sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_reward_content"
            app:layout_constraintTop_toBottomOf="@+id/tv_sub_title"/>
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="@dimen/_177sdp"
            android:layout_height="@dimen/_116sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:src="@drawable/ic_login_gift"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_reward_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/tips_layout"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon">
            <TextView
                android:textSize="10sp"
                android:textColor="@color/common_base_color"
                android:ellipsize="end"
                android:id="@+id/tv_star_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="100dp"
                android:maxLines="2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_action"
            android:background="@drawable/common_solid_btn_bg_radius15"
            android:paddingLeft="@dimen/_8sdp"
            android:paddingRight="@dimen/_8sdp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginLeft="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginRight="@dimen/_16sdp"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:paddingHorizontal="@dimen/_8sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tips_layout">
            <ImageView
                android:id="@+id/iv_action_icon"
                android:visibility="gone"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="@dimen/_8sdp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/theme_text5"
                android:ellipsize="end"
                android:id="@+id/tv_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sr_login"
                android:maxLines="2"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="@dimen/_32sdp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:src="@drawable/ic_login_close_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
