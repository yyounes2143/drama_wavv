<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/root"
    android:visibility="visible"
    android:layout_width="@dimen/_295sdp"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_60sdp"
        android:elevation="0dp"
        app:cardBackgroundColor="@color/theme_surface3"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_calendar_reminder_bg_cover"
            android:scaleType="centerCrop"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/_16sdp"
            android:paddingTop="68dp"
            android:paddingRight="@dimen/_16sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text1"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reserve_series_enable_calendar_tips"
                android:maxLines="3"/>
            <TextView
                android:textSize="@dimen/_16sdp"
                android:textColor="@color/theme_text1"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_request_permission"
                android:background="@drawable/bg_schedule_button"
                android:paddingLeft="@dimen/_16sdp"
                android:paddingTop="@dimen/_12sdp"
                android:paddingRight="@dimen/_16sdp"
                android:paddingBottom="@dimen/_12sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/reserve_series_enable_calendar_confirm"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_12sdp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/theme_text2"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_later"
                android:paddingLeft="@dimen/_16sdp"
                android:paddingTop="@dimen/_12sdp"
                android:paddingRight="@dimen/_16sdp"
                android:paddingBottom="@dimen/_12sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/later_btn"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_12sdp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/layout_no_more_remind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp">
                <ImageView
                    android:id="@+id/cb_no_more_remind"
                    android:layout_width="@dimen/_20sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:src="@drawable/common_checked_box_selector"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/theme_text3"
                    android:id="@+id/tv_no_more_remind"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reserve_series_enable_calendar_no_more_remind"
                    android:layout_marginStart="@dimen/_8sdp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_calendar_reminder"
        android:scaleType="center"/>
</FrameLayout>
