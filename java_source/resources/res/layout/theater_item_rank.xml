<?xml version="1.0" encoding="utf-8"?>
<com.dramawave.feature.theater.view.InterceptConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_conner_8_fill_1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_header_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_theater_rank_item_bg_auto_mirrored"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_header_logo_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:src="@drawable/ic_board_header_left_logo_auto_mirrored"
        android:layout_marginStart="@dimen/_16sdp"
        app:layout_constraintEnd_toStartOf="@+id/title"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.dramawave.core.common.view.GradientTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:gradientDirection="left_to_right"
        app:gradientEndColor="#e3a84d"
        app:gradientStartColor="#f5ddac"
        app:layout_constraintBottom_toBottomOf="@+id/iv_header_logo_left"
        app:layout_constraintEnd_toStartOf="@+id/iv_header_logo_right"
        app:layout_constraintStart_toEndOf="@+id/iv_header_logo_left"
        app:layout_constraintTop_toTopOf="@+id/iv_header_logo_left"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_header_logo_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:src="@drawable/ic_board_header_right_logo_auto_mirrored"
        android:layout_marginEnd="@dimen/_16sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/shape_gradient_7a1e2b_570d20"
        android:layout_width="0dp"
        android:layout_height="@dimen/_40sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:nestedScrollingEnabled="false"
        app:layout_constraintBottom_toTopOf="@+id/tv_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_header_logo_left"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/theme_text1"
        android:gravity="center"
        android:id="@+id/tv_more"
        android:background="@drawable/shape_conner_8_brand6"
        android:padding="@dimen/_6sdp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_8sdp"
        android:layout_marginRight="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:text="@string/home_board_explore_more"
        android:layout_marginHorizontal="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</com.dramawave.feature.theater.view.InterceptConstraintLayout>
