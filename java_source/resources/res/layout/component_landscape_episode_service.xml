<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_root"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layoutDirection="locale">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_follow"
        android:layout_width="wrap_content"
        android:layout_height="28dp">
        <ImageView
            android:id="@+id/iv_follow"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_play_menu_follow"/>
        <com.dramawave.shared.p448ui.view.SafeAnimatedTextView
            android:textSize="12sp"
            android:textColor="@color/theme_text5"
            android:id="@+id/tv_follow_num"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/black_50"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            android:layout_marginStart="@dimen/_4sdp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_episode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_20sdp">
        <ImageView
            android:id="@+id/iv_episode"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/ic_play_menu_drama"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/theme_text5"
            android:id="@+id/tv_episode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/episodes"
            android:maxLines="1"
            android:shadowColor="@color/black_50"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="3"
            android:layout_marginStart="@dimen/_4sdp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/comment_leave_shape_conner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_30sdp"
        android:paddingStart="8dp"
        android:paddingEnd="28dp"
        android:layout_marginStart="@dimen/_20sdp">
        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_leave_comment"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#b2fdfbfc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Leave a comment"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
