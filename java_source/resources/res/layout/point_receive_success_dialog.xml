<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/theme_else_mask"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_point_receive_success_logo_automirror"/>
    <Space
        android:layout_width="1dp"
        android:layout_height="@dimen/_12sdp"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/theme_text2"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/member_point_receive_success"/>
    <Space
        android:layout_width="1dp"
        android:layout_height="@dimen/_8sdp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:src="@drawable/ic_point_exchange_logo"/>
        <Space
            android:layout_width="@dimen/_5sdp"
            android:layout_height="1dp"/>
        <TextView
            android:textSize="@dimen/text_size_24"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_receive_point"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
