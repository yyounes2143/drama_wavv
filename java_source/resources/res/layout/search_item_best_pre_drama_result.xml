<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/search_shape_bg_best_result"
        app:layout_constraintHeight_percent="0.7"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/theme_text1"
        android:id="@+id/best_top_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_14sdp"
        android:layout_marginRight="@dimen/_12sdp"
        android:drawablePadding="@dimen/_4sdp"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/_12sdp"
        app:drawableStartCompat="@drawable/search_ic_good"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.dramawave.shared.general.view.SeriesCoverView
        android:id="@+id/iv_cover"
        android:layout_width="@dimen/_112sdp"
        android:layout_height="@dimen/_149sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/best_top_text"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/theme_text1"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_cover"
        app:layout_constraintTop_toTopOf="@+id/iv_cover"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="@dimen/_16sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_cover"
        app:layout_constraintTop_toBottomOf="@+id/tv_name">
        <TextView
            android:textColor="@color/theme_text2"
            android:id="@+id/tv_reserve_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/theme_TextRegular12"/>
        <TextView
            android:textColor="@color/theme_text2"
            android:id="@+id/tv_split"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" · "
            style="@style/theme_TextRegular12"/>
        <TextView
            android:textColor="@color/theme_text2"
            android:id="@+id/tv_content_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/theme_TextRegular12"/>
    </LinearLayout>
    <com.dramawave.shared.p448ui.view.ReminderButtonView
        android:gravity="center"
        android:id="@+id/ll_reminder"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingRight="@dimen/_16sdp"
        android:layout_width="0dp"
        android:layout_height="@dimen/_32sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:paddingHorizontal="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_cover"
        app:subscribedBackground="@drawable/shape_conner_8_fill_2"
        app:unsubscribedBackground="@drawable/sr_shape_conner_8_brand_6"
        app:useWhiteIcon="true"/>
    <TextView
        android:id="@+id/tv_listing_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_16sdp"
        android:drawablePadding="@dimen/_4sdp"
        app:drawableStartCompat="@drawable/ic_calendar"
        app:layout_constraintBottom_toTopOf="@+id/ll_reminder"
        app:layout_constraintEnd_toEndOf="@+id/ll_reminder"
        app:layout_constraintStart_toStartOf="@+id/ll_reminder"
        style="@style/theme_TextRegular12"/>
    <View
        android:id="@+id/divider"
        android:background="@color/theme_line1"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
