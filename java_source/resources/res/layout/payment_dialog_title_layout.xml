<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/_4sdp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/theme_text2"
            android:id="@+id/tv_this_episode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:text="@string/novel_payment_dailog_chapter"
            android:layout_marginStart="@dimen/_16sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/img_crown_episode"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/ic_common_coin_single_alpha"
            android:contentDescription="@string/mine_empty"
            android:layout_marginStart="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_this_episode"
            app:layout_constraintStart_toEndOf="@+id/tv_this_episode"
            app:layout_constraintTop_toTopOf="@+id/tv_this_episode"/>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/theme_text2"
            android:id="@+id/tv_episode_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            app:layout_constraintBottom_toBottomOf="@+id/img_crown_episode"
            app:layout_constraintStart_toEndOf="@+id/img_crown_episode"
            app:layout_constraintTop_toTopOf="@+id/img_crown_episode"/>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/theme_text3"
            android:id="@+id/tv_discount_episode_count"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_episode_count"
            app:layout_constraintStart_toEndOf="@+id/tv_episode_count"
            app:layout_constraintTop_toTopOf="@+id/tv_episode_count"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/theme_text2"
            android:id="@+id/tv_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/balance"
            android:layout_marginStart="@dimen/_12sdp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_discount_episode_count"
            app:layout_constraintStart_toEndOf="@+id/tv_discount_episode_count"
            app:layout_constraintTop_toTopOf="@+id/tv_discount_episode_count"/>
        <ImageView
            android:id="@+id/img_crown_balance"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/ic_common_coin_single_alpha"
            android:contentDescription="@string/mine_empty"
            android:layout_marginStart="@dimen/_4sdp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_balance"
            app:layout_constraintStart_toEndOf="@+id/tv_balance"
            app:layout_constraintTop_toTopOf="@+id/tv_balance"/>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/theme_text2"
            android:id="@+id/tv_balance_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_2sdp"
            app:layout_constraintBottom_toBottomOf="@+id/img_crown_balance"
            app:layout_constraintStart_toEndOf="@+id/img_crown_balance"
            app:layout_constraintTop_toTopOf="@+id/img_crown_balance"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/_16sdp"
        android:textStyle="bold"
        android:textColor="@color/theme_text2"
        android:gravity="center"
        android:id="@+id/tv_title_content"
        android:paddingBottom="@dimen/_8sdp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="@string/purchase_members_ship_only"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/img_close"
        android:paddingTop="@dimen/_12sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_close_payment_dialog"
        android:contentDescription="@string/mine_empty"
        android:layout_marginEnd="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
