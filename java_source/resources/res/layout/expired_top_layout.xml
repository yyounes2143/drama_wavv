<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingLeft="@dimen/_24sdp"
    android:paddingRight="@dimen/_24sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_24sdp">
    <TextView
        android:textSize="@dimen/_16sdp"
        android:textColor="@color/theme_text3"
        android:gravity="start"
        android:layout_gravity="start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_4sdp"
        android:text="@string/expired_vip_title"
        android:textAlignment="viewStart"/>
    <TextView
        android:textSize="@dimen/_32sdp"
        android:textStyle="bold"
        android:textColor="@color/theme_text1"
        android:gravity="start"
        android:layout_gravity="start"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_12sdp"
        android:textAlignment="viewStart"
        android:layout_marginEnd="@dimen/_67sdp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_app_score"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_4sdp">
        <com.dramawave.shared.p448ui.widget.StarRatingView
            android:id="@+id/sv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"/>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textStyle="bold"
            android:textColor="@color/theme_text12"
            android:gravity="center"
            android:id="@+id/tv_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_4sdp"/>
        <TextView
            android:textSize="@dimen/_14sdp"
            android:textColor="@color/theme_text2"
            android:gravity="start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expired_vip_google_play"
            android:textAlignment="viewStart"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/theme_text3"
            android:gravity="start"
            android:id="@+id/tv_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"/>
    </LinearLayout>
</LinearLayout>
