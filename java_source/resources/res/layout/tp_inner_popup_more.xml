<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/tp_inner_popup_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="220dp"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tp_ll_advertiser"
                android:paddingRight="14dp"
                android:layout_width="match_parent"
                android:layout_height="42dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="14dp"
                    android:src="@drawable/tp_pop_advertiser"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#178af5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="@string/tp_pop_advertiser"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tp_ll_copy"
                android:paddingRight="14dp"
                android:layout_width="match_parent"
                android:layout_height="42dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginLeft="14dp"
                    android:src="@drawable/tp_pop_copy"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#178af5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:text="@string/tp_pop_copy"/>
            </LinearLayout>
            <TextView
                android:textSize="10sp"
                android:textColor="#b8b8b8"
                android:id="@+id/tp_tv_content"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"/>
        </LinearLayout>
    </FrameLayout>
    <ImageView
        android:layout_gravity="right"
        android:id="@+id/tp_img_close"
        android:padding="7dp"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/tp_inner_ad_pop_close"/>
</FrameLayout>
