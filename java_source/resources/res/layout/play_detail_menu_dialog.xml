<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/container"
    android:background="@drawable/common_shape_conner_12_top_surface_2"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_faq"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingRight="@dimen/_16sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            app:srcCompat="@drawable/profile_ic_service_center"
            app:tint="@color/theme_text1"/>
        <TextView
            android:textColor="@color/theme_text2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sr_faq"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_8sdp"
            style="@style/theme_TextMedium16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:tint="@color/theme_text3"
            app:srcCompat="@drawable/ic_chevron_right_automirror"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_feed_back"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingRight="@dimen/_16sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            app:srcCompat="@drawable/ic_envelope"
            app:tint="@color/theme_text1"/>
        <TextView
            android:textColor="@color/theme_text2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sr_feedback"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_8sdp"
            style="@style/theme_TextMedium16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:tint="@color/theme_text3"
            app:srcCompat="@drawable/ic_chevron_right_automirror"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_share"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingRight="@dimen/_16sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            app:srcCompat="@drawable/ic_share_menu"
            app:tint="@color/theme_text1"/>
        <TextView
            android:textColor="@color/theme_text2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sr_share"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_8sdp"
            style="@style/theme_TextMedium16"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:tint="@color/theme_text3"
            app:srcCompat="@drawable/ic_chevron_right_automirror"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_pip"
        android:paddingLeft="@dimen/_16sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingRight="@dimen/_16sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingVertical="@dimen/_12sdp">
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_pip_mode"/>
        <TextView
            android:textColor="@color/theme_text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sr_pip_mode"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/_8sdp"
            style="@style/theme_TextMedium16"/>
        <Space
            android:layout_width="@dimen/_4sdp"
            android:layout_height="@dimen/_1sdp"/>
        <ImageView
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_10sdp"
            android:src="@drawable/ic_pip_vip"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sc_pip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:thumb="@drawable/switch_thumb"
            app:switchMinWidth="@dimen/_44sdp"
            app:switchPadding="@dimen/_2sdp"
            app:track="@drawable/switch_track_style"/>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_20sdp"/>
</LinearLayout>
