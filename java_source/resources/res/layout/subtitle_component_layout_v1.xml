<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintGuide_percent="0.646"/>
    <View
        android:orientation="horizontal"
        android:id="@+id/landscape_video_guideline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <com.dramawave.shared.p448ui.view.textview.StrokeTextView
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text5"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:maxLines="3"
        android:shadowColor="#82000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="12"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="@+id/guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline"
        app:stroke="@dimen/_2sdp"
        app:strokeColor="@color/subtitle_stroke_color"/>
    <com.dramawave.shared.p448ui.view.textview.StrokeTextView
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text5"
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_landscape_subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_80sdp"
        android:layout_marginRight="@dimen/_80sdp"
        android:layout_marginBottom="36dp"
        android:maxLines="2"
        android:lines="2"
        android:shadowColor="#82000000"
        android:shadowDx="0"
        android:shadowDy="3"
        android:shadowRadius="12"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/_80sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:stroke="@dimen/_2sdp"
        app:strokeColor="@color/subtitle_stroke_color"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text5"
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_pip_subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:maxLines="2"
        android:shadowColor="#f2000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="10"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/_16sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
