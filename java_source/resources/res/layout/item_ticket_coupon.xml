<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">
    <com.dramawave.shared.p448ui.view.CouponView
        android:id="@+id/ticket_view"
        android:background="#434546"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:gap="@dimen/_4sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/iv_poster"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_poster"
        app:radius="@dimen/_4sdp"
        app:radiusBackgroundColor="#000000"
        app:showBottom="true">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.dramawave.shared.p448ui.view.CouponImageView
                android:id="@+id/iv_poster"
                android:background="#434546"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                app:gap="@dimen/_4sdp"
                app:layout_constraintTop_toTopOf="parent"
                app:radius="@dimen/_4sdp"
                app:radiusBackgroundColor="#000000"
                app:showTop="true"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_12sdp"
                android:maxLines="2"
                android:layout_marginHorizontal="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@+id/iv_poster"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="#ccffffff"
                android:id="@+id/tv_episode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginRight="@dimen/_12sdp"
                android:layout_marginHorizontal="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <TextView
                android:textSize="@dimen/text_size_8"
                android:textColor="#80fdfbfc"
                android:id="@+id/tv_watch_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:layout_marginRight="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:layout_marginHorizontal="@dimen/_12sdp"
                app:layout_constraintTop_toBottomOf="@+id/tv_episode"/>
            <View
                android:id="@+id/divider"
                android:background="@drawable/profile_ticket_item_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_2sdp"
                android:layout_marginLeft="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginVertical="@dimen/_8sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_watch_date"/>
            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_11sdp"
                android:src="@drawable/ic_message_head"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/divider"
                app:layout_constraintTop_toBottomOf="@+id/divider"/>
            <TextView
                android:textSize="@dimen/text_size_10"
                android:textColor="#b3fdfbfc"
                android:id="@+id/tv_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_4sdp"
                android:layout_marginRight="@dimen/_4sdp"
                android:layout_marginHorizontal="@dimen/_4sdp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
                app:layout_constraintStart_toEndOf="@+id/iv_cover"
                app:layout_constraintTop_toTopOf="@+id/iv_cover"/>
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="@dimen/_17sdp"
                android:layout_height="@dimen/_17sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:src="@drawable/ic_ticket_dramawave_icon"
                android:scaleType="centerCrop"
                android:layout_marginVertical="@dimen/_8sdp"
                app:layout_constraintEnd_toEndOf="@+id/divider"
                app:layout_constraintTop_toBottomOf="@+id/divider"/>
            <View
                android:id="@+id/mask_view"
                android:background="@drawable/profile_ticket_gradient_mask"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_poster"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.dramawave.shared.p448ui.view.CouponView>
</FrameLayout>
