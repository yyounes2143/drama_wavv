<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_123sdp"
    android:layout_height="@dimen/_202sdp"
    android:elevation="0dp"
    app:cardBackgroundColor="@color/theme_fill1"
    app:cardCornerRadius="@dimen/_8sdp">
    <ImageView
        android:id="@+id/iv_cover"
        android:layout_width="@dimen/_123sdp"
        android:layout_height="@dimen/_164sdp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/v_gradient"
        android:background="@drawable/ugc_hash_tag_item_template_card_gradient"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_26sdp"
        android:layout_marginBottom="@dimen/_36sdp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/ugc_text_1"
        android:layout_gravity="start|top"
        android:id="@+id/tv_episode_label"
        android:background="@drawable/ugc_topic_bg_tag"
        android:paddingTop="@dimen/_2sdp"
        android:paddingBottom="@dimen/_2sdp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/_8sdp"
        android:paddingEnd="@dimen/_8sdp"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="bottom"
        android:background="@drawable/ugc_hash_tag_btn_remix_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        android:layout_marginStart="@dimen/_6sdp"
        android:layout_marginEnd="@dimen/_6sdp">
        <ImageView
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:src="@drawable/ic_ugc_hashtag_template_remix"/>
        <TextView
            android:textSize="@dimen/text_size_13"
            android:textColor="#fdfbfc"
            android:gravity="center"
            android:id="@+id/btn_remix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ugc_remix"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/_4sdp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
