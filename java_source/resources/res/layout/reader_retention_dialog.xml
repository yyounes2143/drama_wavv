<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/sr_shape_top_end_radius_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/theme_text1"
        android:gravity="center"
        android:id="@+id/tv_retention_message"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_32sdp"
        android:text="@string/novel_add_to_my_list"
        android:layout_marginHorizontal="@dimen/_32sdp"
        android:paddingVertical="@dimen/_8sdp"
        style="@style/theme_TextBold24"/>
    <TextView
        android:textColor="@color/theme_text1"
        android:gravity="center"
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginRight="@dimen/_32sdp"
        android:text="@string/novel_add_to_my_list_subtitle"
        android:layout_marginHorizontal="@dimen/_32sdp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_button_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_32sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginRight="@dimen/_32sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:layout_marginHorizontal="@dimen/_32sdp">
        <TextView
            android:textColor="@color/theme_text5"
            android:gravity="center"
            android:id="@+id/tv_confirm"
            android:background="@drawable/shape_conner_8_brand6"
            android:paddingTop="@dimen/_12sdp"
            android:paddingBottom="@dimen/_12sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/confirm"
            android:backgroundTint="@color/theme_brand6"
            android:paddingVertical="@dimen/_12sdp"
            style="@style/theme_TextMedium16"/>
        <TextView
            android:textColor="@color/theme_text2"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:paddingTop="@dimen/_12sdp"
            android:paddingBottom="@dimen/_12sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel_up"
            android:paddingVertical="@dimen/_12sdp"
            style="@style/theme_TextMedium16"/>
    </LinearLayout>
</LinearLayout>
