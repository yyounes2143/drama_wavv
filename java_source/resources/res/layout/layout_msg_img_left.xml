<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.dramawave.shared.p448ui.view.EnhancedImageView
        android:id="@+id/avatar"
        android:layout_width="@dimen/_42sdp"
        android:layout_height="@dimen/_42sdp"
        android:scaleType="centerCrop"
        app:ei_roundCornerRadius="@dimen/_12sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12sp"
            android:textColor="#ff666666"
            android:id="@+id/nickName"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="2dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentGroup"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/common_ic_cover_default"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:layout_marginStart="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/contentGroup"
                app:layout_constraintEnd_toEndOf="@+id/contentGroup"
                app:layout_constraintStart_toStartOf="@+id/contentGroup"
                app:layout_constraintTop_toTopOf="@+id/contentGroup"/>
            <ProgressBar
                android:id="@+id/circleBar"
                android:visibility="gone"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="wrap_content"
                android:indeterminateTint="#a1a2a3"
                android:indeterminateTintMode="src_atop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.AppCompat.ProgressBar"/>
            <com.dramawave.feature.home.chat.view.SendStateView
                android:id="@+id/sendState"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="@+id/contentGroup"
                app:layout_constraintStart_toEndOf="@+id/contentGroup"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
