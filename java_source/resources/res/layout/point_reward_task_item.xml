<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/_12sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingRight="@dimen/_12sdp"
    android:paddingBottom="@dimen/_12sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_12sdp"
    android:paddingVertical="@dimen/_12sdp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/layout_task_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_task_action"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:textColor="@color/theme_text1"
            android:id="@+id/tv_task_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/theme_D4A54A"
            android:id="@+id/tv_task_reward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:maxLines="1"
            android:drawablePadding="@dimen/_4sdp"
            android:drawableStart="@drawable/ic_point_exchange_logo"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_task_progress"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp">
            <ProgressBar
                android:id="@+id/progress_task"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_5sdp"
                android:max="1000"
                android:progress="350"
                android:progressDrawable="@drawable/bg_point_reward_task_progress"
                android:minHeight="@dimen/_5sdp"
                style="?android:attr/progressBarStyleHorizontal"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/theme_text3"
                android:id="@+id/tv_task_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textStyle="bold"
        android:textColor="@color/selector_point_reward_task_action_text"
        android:gravity="center"
        android:id="@+id/tv_task_action"
        android:background="@drawable/selector_point_reward_task_action"
        android:layout_width="@dimen/_84sdp"
        android:layout_height="@dimen/_32sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
