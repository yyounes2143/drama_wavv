<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_12sdp">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_8sdp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/content_layout"
            android:background="@drawable/novel_coins_card_bg_new"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_82sdp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="7"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="0dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_16sdp"
                        android:textStyle="bold"
                        android:textColor="@color/reader_style_0_text_primary"
                        android:id="@+id/tv_coins_quantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="@dimen/_12sdp"
                        android:textColor="@color/reader_style_0_text_primary"
                        android:id="@+id/tv_coins_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/coins_text"
                        android:includeFontPadding="false"
                        android:layout_marginStart="@dimen/_2sdp"/>
                </LinearLayout>
                <TextView
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/reader_style_0_brand_1"
                    android:id="@+id/tv_coins_bonus"
                    android:background="@drawable/novel_bonus_tag_bg"
                    android:paddingLeft="@dimen/_6sdp"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingRight="@dimen/_6sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:paddingVertical="@dimen/_2sdp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="#0d000000"
                android:paddingLeft="@dimen/_12sdp"
                android:paddingRight="@dimen/_12sdp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:paddingHorizontal="@dimen/_12sdp">
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textColor="@color/reader_style_0_text_primary"
                    android:id="@+id/tv_format_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="@dimen/_14sdp"
                    android:textStyle="bold"
                    android:textColor="#fc2763"
                    android:id="@+id/tv_discount_percent"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <include
            android:layout_gravity="end|top"
            android:id="@+id/include_purchase_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/purchase_tag_layout"/>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
