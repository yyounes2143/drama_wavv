<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/border_theme_line2"
    android:padding="0.5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_12sdp"
        app:cardElevation="0dp">
        <FrameLayout
            android:id="@+id/fl_banner_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.dramawave.shared.general.view.SeriesCoverView
                android:id="@+id/iv_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/_20sdp"/>
            <View
                android:layout_gravity="bottom"
                android:background="@color/theme_surface1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp"/>
            <ImageView
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_80sdp"
                android:src="@drawable/vip_banner_item_bg"
                android:scaleType="fitXY"/>
            <ImageView
                android:layout_gravity="start|top"
                android:layout_width="@dimen/_45sdp"
                android:layout_height="@dimen/_18sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:src="@drawable/ic_vip_logo"
                android:layout_marginStart="@dimen/_6sdp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.dramawave.shared.p448ui.tag.ContentTagsView
                    android:layout_gravity="start|bottom"
                    android:id="@+id/series_tag_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:layout_marginBottom="@dimen/_4sdp"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    app:customTagLayoutId="@layout/item_content_tag_default_on_cover_bold"
                    app:layout_constraintBottom_toTopOf="@+id/video_name"
                    app:layout_constraintEnd_toStartOf="@+id/iv_vip_play"
                    app:layout_constraintStart_toStartOf="parent"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/theme_text1"
                    android:ellipsize="end"
                    android:id="@+id/video_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:maxLines="1"
                    android:shadowColor="@color/black_60"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textAlignment="viewStart"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_vip_play"
                    app:layout_constraintStart_toStartOf="parent"/>
                <ImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/iv_vip_play"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_28sdp"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:src="@drawable/ic_vip_play"
                    android:layout_marginEnd="@dimen/_4sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/theme_text1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/video_name_center"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:maxLines="1"
                    android:shadowColor="@color/black_60"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_vip_play"
                    app:layout_constraintEnd_toStartOf="@+id/iv_vip_play"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/iv_vip_play"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
