<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="@dimen/_60sdp"
    android:layout_height="@dimen/_80sdp"
    android:layout_marginEnd="@dimen/_6sdp">
    <FrameLayout
        android:background="@drawable/common_shape_conner_12_fill2"
        android:layout_width="@dimen/_60sdp"
        android:layout_height="@dimen/_60sdp"
        android:clipToOutline="true">
        <ImageView
            android:id="@+id/option_cover"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
        <View
            android:background="@drawable/bg_ugc_stories_option"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <View
            android:id="@+id/option_selected_stroke"
            android:background="@drawable/bg_ugc_stories_option_selected"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white_70"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/option_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:maxLines="1"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"/>
</LinearLayout>
