<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.dramawave.shared.p448ui.view.CouponView
                android:layout_gravity="center"
                android:id="@+id/ticket_view"
                android:background="#434546"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_47sdp"
                android:layout_marginTop="@dimen/_82sdp"
                android:layout_marginRight="@dimen/_47sdp"
                android:layout_marginHorizontal="@dimen/_47sdp"
                app:gap="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/iv_poster"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_poster"
                app:radius="@dimen/_7sdp"
                app:radiusBackgroundColor="#000000"
                app:showBottom="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.dramawave.shared.p448ui.view.CouponImageView
                        android:id="@+id/iv_poster"
                        android:background="#434546"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scaleType="fitStart"
                        android:adjustViewBounds="true"
                        app:gap="@dimen/_8sdp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:radius="@dimen/_7sdp"
                        app:radiusBackgroundColor="#000000"
                        app:showTop="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_24"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        android:id="@+id/tv_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:layout_marginRight="@dimen/_12sdp"
                        android:maxLines="2"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        app:layout_constraintTop_toBottomOf="@+id/iv_poster"/>
                    <TextView
                        android:textSize="@dimen/text_size_18"
                        android:textColor="#ccffffff"
                        android:id="@+id/tv_episode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginRight="@dimen/_12sdp"
                        android:maxLines="2"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
                    <TextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="#80fdfbfc"
                        android:id="@+id/tv_watch_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginRight="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_12sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_episode"/>
                    <View
                        android:id="@+id/divider"
                        android:background="@drawable/profile_ticket_item_divider"
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_marginLeft="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginRight="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:layout_marginVertical="@dimen/_8sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_watch_date"/>
                    <ImageView
                        android:id="@+id/iv_cover"
                        android:layout_width="@dimen/_27sdp"
                        android:layout_height="@dimen/_27sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_17sdp"
                        android:src="@drawable/ic_message_head"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/divider"
                        app:layout_constraintTop_toBottomOf="@+id/divider"/>
                    <TextView
                        android:textSize="@dimen/text_size_16"
                        android:textColor="#b3fdfbfc"
                        android:id="@+id/tv_user"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_4sdp"
                        android:layout_marginRight="@dimen/_4sdp"
                        android:layout_marginHorizontal="@dimen/_4sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
                        app:layout_constraintStart_toEndOf="@+id/iv_cover"
                        app:layout_constraintTop_toTopOf="@+id/iv_cover"/>
                    <ImageView
                        android:id="@+id/iv_icon"
                        android:layout_width="@dimen/_27sdp"
                        android:layout_height="@dimen/_27sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:src="@drawable/ic_ticket_dramawave_icon"
                        android:scaleType="centerCrop"
                        android:layout_marginVertical="@dimen/_8sdp"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
                        app:layout_constraintEnd_toEndOf="@+id/divider"
                        app:layout_constraintTop_toTopOf="@+id/iv_cover"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.dramawave.shared.p448ui.view.CouponView>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnSave"
                android:background="@drawable/profile_background_delete"
                android:paddingTop="@dimen/_6sdp"
                android:paddingBottom="@dimen/_6sdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_32sdp"
                android:text="Download"
                android:drawablePadding="@dimen/_4sdp"
                android:drawableStart="@drawable/profile_ic_my_download"
                android:paddingStart="@dimen/_20sdp"
                android:paddingEnd="@dimen/_20sdp"
                android:drawableTint="@color/white"
                android:paddingVertical="@dimen/_6sdp"
                app:drawableTint="@color/white"/>
        </LinearLayout>
    </ScrollView>
    <ImageButton
        android:id="@+id/im_close"
        android:background="@null"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginLeft="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_22sdp"
        android:layout_marginRight="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_22sdp"
        android:src="@drawable/ic_cancel"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginVertical="@dimen/_22sdp"/>
</FrameLayout>
