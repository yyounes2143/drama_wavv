<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/sr_shape_top_end_radius_12_surface3"
    android:paddingBottom="@dimen/_8sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/theme_brand6"
        android:gravity="center"
        android:id="@+id/tv_delete"
        android:paddingTop="@dimen/_16sdp"
        android:paddingBottom="@dimen/_16sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sr_mine_delete"
        android:paddingVertical="@dimen/_16sdp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_divider"
        android:background="@color/theme_surface2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_2sdp"
        app:layout_constraintTop_toBottomOf="@+id/tv_delete"/>
    <TextView
        android:textSize="@dimen/normal_text_14"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:paddingTop="@dimen/_16sdp"
        android:paddingBottom="@dimen/_16sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mine_dialog_logout_cancel"
        android:paddingVertical="@dimen/_16sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider"
        style="@style/theme_TextRegular14"/>
</androidx.constraintlayout.widget.ConstraintLayout>
