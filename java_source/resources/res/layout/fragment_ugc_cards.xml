<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/ugc_surface_1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.dramawave.shared.p448ui.view.content.ContentContainer
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:content_view_id="@+id/cards_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cards_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:layout_marginLeft="@dimen/_36sdp"
                android:layout_marginRight="@dimen/_36sdp"
                android:layout_marginHorizontal="@dimen/_36sdp"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_gravity="center"
                    android:id="@+id/role_list"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
                <View
                    android:layout_gravity="start"
                    android:id="@+id/role_start_mask"
                    android:background="@drawable/ugc_cards_role_start_mask"
                    android:visibility="gone"
                    android:layout_width="@dimen/_48sdp"
                    android:layout_height="match_parent"/>
                <View
                    android:layout_gravity="end"
                    android:id="@+id/role_end_mask"
                    android:background="@drawable/ugc_cards_role_end_mask"
                    android:visibility="gone"
                    android:layout_width="@dimen/_48sdp"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/role_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/bottom_actions"
                app:layout_constraintTop_toBottomOf="@+id/top_bar"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/bottom_actions"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_60sdp"
                android:paddingStart="@dimen/_12sdp"
                android:paddingEnd="@dimen/_12sdp"
                app:layout_constraintBottom_toBottomOf="parent">
                <com.google.android.material.button.MaterialButton
                    android:textSize="16sp"
                    android:textColor="@color/ugc_text_1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/change_avatar_button"
                    android:paddingLeft="@dimen/_12sdp"
                    android:paddingRight="@dimen/_12sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_44sdp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/ugc_cards_play_as_you"
                    android:maxLines="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0"
                    android:paddingHorizontal="@dimen/_12sdp"
                    app:backgroundTint="@color/ugc_fill_2"
                    app:cornerRadius="@dimen/_8sdp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/change_avatar_max_width_guideline"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.Guideline
                    android:orientation="vertical"
                    android:id="@+id/change_avatar_max_width_guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintGuide_percent="0.4"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="16sp"
                    android:textColor="@color/ugc_text_1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/primary_button"
                    android:paddingLeft="@dimen/_12sdp"
                    android:paddingRight="@dimen/_12sdp"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_44sdp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:maxLines="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:letterSpacing="0"
                    android:paddingHorizontal="@dimen/_12sdp"
                    app:backgroundTint="@color/ugc_brand_6"
                    app:cornerRadius="@dimen/_8sdp"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/_6sdp"
                    app:iconSize="@dimen/_18sdp"
                    app:iconTint="@null"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/change_avatar_button"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/ugc_text_2"
                android:gravity="center"
                android:id="@+id/state_message"
                android:paddingLeft="@dimen/_16sdp"
                android:paddingRight="@dimen/_16sdp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_44sdp"
                android:paddingHorizontal="@dimen/_16sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.dramawave.shared.p448ui.view.content.ContentContainer>
    <ImageView
        android:id="@+id/close_button"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:src="@drawable/ugc_ic_close"
        android:contentDescription="@null"
        android:layout_marginStart="@dimen/_12sdp"
        android:elevation="@dimen/_1sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
