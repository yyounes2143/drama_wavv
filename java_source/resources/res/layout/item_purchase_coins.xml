<?xml version="1.0" encoding="utf-8"?>
<com.dramawave.shared.p448ui.view.ShadowClipConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/payment_selector_coins_new"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_71sdp"
    android:layout_marginLeft="@dimen/_6sdp"
    android:layout_marginRight="@dimen/_6sdp"
    android:layout_marginBottom="@dimen/_12sdp"
    android:layout_marginHorizontal="@dimen/_6sdp"
    app:shadowRlRadius="@dimen/_8sdp">
    <ImageView
        android:id="@+id/img_small_coin"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:src="@drawable/ic_common_coin_single"
        android:contentDescription="@string/mine_empty"
        android:layout_marginStart="@dimen/_12sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/_18sdp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tv_coins_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="@+id/img_small_coin"
        app:layout_constraintStart_toEndOf="@+id/img_small_coin"
        app:layout_constraintTop_toTopOf="@+id/img_small_coin"/>
    <TextView
        android:textSize="@dimen/_14sdp"
        android:textColor="@color/theme_text2"
        android:id="@+id/tv_coins_bonus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/_2sdp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_coins_quantity"
        app:layout_constraintStart_toEndOf="@+id/tv_coins_quantity"
        app:layout_constraintTop_toTopOf="@+id/tv_coins_quantity"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <Space
            android:layout_width="@dimen/_50sdp"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_coins_label"
            android:background="@drawable/payment_bg_coin_label"
            android:paddingLeft="@dimen/_4sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingRight="@dimen/_4sdp"
            android:paddingBottom="@dimen/_2sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_4sdp"
            android:paddingVertical="@dimen/_2sdp">
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"
                android:textColor="@color/theme_text1"
                android:ellipsize="end"
                android:id="@+id/tv_coins_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"
                android:textColor="@color/theme_text1"
                android:id="@+id/tv_expire_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"/>
            <ImageView
                android:id="@+id/iv_upper"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/payment_ic_coin_up"
                android:contentDescription="@string/mine_empty"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/_14sdp"
        android:textColor="@color/theme_text2"
        android:gravity="center"
        android:id="@+id/tv_formatPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginStart="@dimen/_14sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_small_coin"/>
    <com.dramawave.shared.p448ui.view.PurchaseFlashView
        android:id="@+id/psv_coins_selected"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@drawable/profile_store_top_scan"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</com.dramawave.shared.p448ui.view.ShadowClipConstraintLayout>
