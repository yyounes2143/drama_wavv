<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_content"
    android:background="@color/theme_surface1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <include
                android:id="@+id/ic_upgrade_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/update_content_layout"/>
            <TextView
                android:layout_gravity="top"
                android:background="@drawable/common_gradient_top_black"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_100sdp"/>
            <TextView
                android:layout_gravity="bottom"
                android:background="@drawable/common_gradient_black"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp"/>
        </FrameLayout>
        <View
            android:background="@color/theme_line1"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"/>
        <include
            android:id="@+id/ic_bottom_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_12sdp"
            android:layout_marginRight="@dimen/_12sdp"
            android:layout_marginHorizontal="@dimen/_12sdp"
            layout="@layout/update_purchase_bottom_layout"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_title_layout"
        android:paddingLeft="@dimen/_12sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingRight="@dimen/_12sdp"
        android:paddingBottom="@dimen/_14sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_14sdp">
        <ImageView
            android:id="@+id/iv_close"
            android:padding="@dimen/_4sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_guide_close"/>
        <TextView
            android:textSize="@dimen/_16sdp"
            android:textColor="@color/theme_text1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/upgrade_purchase_dialog_title"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_36sdp"/>
    </LinearLayout>
</FrameLayout>
