<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="@dimen/_12sdp"
    android:paddingRight="@dimen/_12sdp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/_12sdp">
    <com.dramawave.shared.general.view.SeriesCoverView
        android:id="@+id/iv_cover"
        android:layout_width="@dimen/_90sdp"
        android:layout_height="@dimen/_120sdp"
        app:isShowOperatorTag="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_bottom_cover"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_novel_item_bottom_bg"
        app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
        app:layout_constraintEnd_toEndOf="@+id/iv_cover"
        app:layout_constraintStart_toStartOf="@+id/iv_cover"/>
    <TextView
        android:textSize="@dimen/text_size_13"
        android:textStyle="bold"
        android:textColor="@color/theme_text1"
        android:id="@+id/tv_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_4sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
        app:layout_constraintEnd_toEndOf="@+id/iv_cover"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/theme_text1"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_12sdp"
        android:layout_marginTop="2dp"
        android:layout_marginRight="@dimen/_12sdp"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_cover"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/theme_text3"
        android:ellipsize="end"
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginRight="@dimen/_12sdp"
        android:maxLines="3"
        android:includeFontPadding="false"
        android:lineSpacingExtra="@dimen/_2sdp"
        android:textAlignment="viewStart"
        android:layout_marginHorizontal="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_cover"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.dramawave.shared.p448ui.tag.ContentTagsView
        android:id="@+id/novel_content_tag_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:layout_marginStart="@dimen/_12sdp"
        app:displayMode="singleLine"
        app:layout_constraintBottom_toBottomOf="@+id/iv_cover"
        app:layout_constraintEnd_toStartOf="@+id/tv_view_counts"
        app:layout_constraintStart_toEndOf="@+id/iv_cover"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"
        app:layout_constraintVertical_bias="1"
        app:showOnCover="false"
        app:showOneTag="false"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/theme_brand6"
        android:id="@+id/tv_view_counts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/_2sdp"
        app:drawableStartCompat="@drawable/ic_novel_look_counts"
        app:layout_constraintBottom_toBottomOf="@+id/novel_content_tag_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/novel_content_tag_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
