<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/theme_surface1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_watchHistory_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:text="@string/mine_tab_watch_history"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="1"
        android:layout_marginEnd="@dimen/_6sdp"
        android:layout_marginVertical="@dimen/_16sdp"
        style="@style/theme_TextBold16"/>
    <TextView
        android:textColor="@color/theme_text2"
        android:id="@+id/tv_view_sub"
        android:background="@drawable/history_view_sub_bg"
        android:paddingLeft="@dimen/_12sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingRight="@dimen/_12sdp"
        android:paddingBottom="@dimen/_8sdp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_16sdp"
        android:text="@string/ticket_stub_view_label"
        android:drawablePadding="@dimen/_8sdp"
        android:drawableStart="@drawable/history_ic_ticket_sub"
        android:drawableEnd="@drawable/ic_check_arrow_right_automirror"
        android:layout_marginEnd="@dimen/_6sdp"
        android:drawableTint="#cccacb"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_watch_history"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_6sdp">
        <TextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_novel_shelf_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:text="@string/mylist_my_list"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            android:layout_marginVertical="@dimen/_16sdp"
            style="@style/theme_TextBold16"/>
        <ImageView
            android:id="@+id/btn_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_edit"
            android:contentDescription="@string/mine_empty"
            android:paddingVertical="@dimen/_8sdp"/>
    </LinearLayout>
    <include
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/empty_view_layout"/>
</LinearLayout>
