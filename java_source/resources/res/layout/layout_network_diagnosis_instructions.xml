<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/instructions_container"
    android:background="@color/theme_surface1"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="12dp">
    <TextView
        android:textSize="19sp"
        android:textColor="@color/theme_text5"
        android:gravity="center"
        android:layout_gravity="bottom"
        android:id="@+id/go_to_settings"
        android:background="@drawable/bg_network_diagnosis_go_to_settings"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="4dp"
        android:text="@string/network_diagnosis_go_to_settings"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="55dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:text="@string/network_diagnosis_instruction"/>
            <View
                android:background="@color/theme_line2"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:text="@string/network_diagnosis_steps_title"/>
            <TextView
                android:layout_marginTop="12dp"
                android:text="@string/network_diagnosis_steps1"
                style="@style/NetworkDiagnosisSteps"/>
            <TextView
                android:layout_marginTop="8dp"
                android:text="@string/network_diagnosis_steps2"
                style="@style/NetworkDiagnosisSteps"/>
            <TextView
                android:layout_marginTop="8dp"
                android:text="@string/network_diagnosis_steps3"
                style="@style/NetworkDiagnosisSteps"/>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
