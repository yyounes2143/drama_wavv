<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/theme_fill2"
    android:padding="24dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/btn_close"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="4dp"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_close_circle"
        android:contentDescription="关闭弹窗"/>
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text1"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="试用期VIP专享"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/theme_text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户评分："/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/theme_brand6"
            android:id="@+id/tv_app_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/theme_text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="评论数："
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/theme_brand6"
            android:id="@+id/tv_app_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/theme_text2"
        android:gravity="center"
        android:id="@+id/tv_product_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/common_base_color"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="�� 试用期专享优惠"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/common_base_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="• 无限制观看所有内容\10• 无广告打扰\10• 专属VIP标识\10• 优先客服支持"
        android:lineSpacingExtra="4dp"/>
    <Button
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:id="@+id/btn_subscribe"
        android:background="@color/theme_fill1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="32dp"
        android:text="立即订阅VIP"
        android:elevation="2dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/theme_text3"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="点击订阅即表示同意《服务协议》和《隐私政策》"/>
</LinearLayout>
