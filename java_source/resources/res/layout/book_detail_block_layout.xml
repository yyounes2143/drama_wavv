<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/_24sdp"
            android:paddingTop="@dimen/_12sdp"
            android:paddingRight="@dimen/_24sdp"
            android:paddingBottom="@dimen/_24sdp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_24sdp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">
                <ImageView
                    android:id="@+id/iv_cover"
                    android:background="@drawable/common_ic_default"
                    android:layout_width="90dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingTop="@dimen/_4sdp"
                    android:paddingBottom="@dimen/_4sdp"
                    android:layout_width="0dp"
                    android:layout_height="120dp"
                    android:layout_weight="1"
                    android:paddingVertical="@dimen/_4sdp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/reader_text_primary"
                            android:ellipsize="end"
                            android:id="@+id/tv_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="2"
                            android:lineSpacingMultiplier="1.2"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="?attr/reader_text_secondary"
                            android:id="@+id/tv_author"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_20sdp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_novel_book"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_novel_book"
                            android:layout_marginEnd="8dp"
                            app:tint="?attr/reader_text_primary"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="?attr/reader_text_primary"
                            android:id="@+id/tv_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_novel_stats"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="?attr/reader_text_primary"
                            android:id="@+id/tv_views_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/reader_text_primary"
                            android:id="@+id/tv_views_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="?attr/reader_text_secondary"
                        android:id="@+id/tv_views_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/novel_detail_views"/>
                </LinearLayout>
                <View
                    android:id="@+id/v_separator"
                    android:background="?attr/reader_border_primary"
                    android:layout_width="0.5dp"
                    android:layout_height="match_parent"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="?attr/reader_text_primary"
                            android:id="@+id/tv_words_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/reader_text_primary"
                            android:id="@+id/tv_works_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="?attr/reader_text_secondary"
                        android:id="@+id/tv_words_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/novel_detail_words"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/reader_text_primary"
                        android:id="@+id/tv_tags_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/synopsis"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/rv_tags"
                        android:clipToPadding="false"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </LinearLayout>
                <com.dramawave.shared.p448ui.view.ExpandableTextView
                    android:textSize="14sp"
                    android:textColor="?attr/reader_text_primary"
                    android:id="@+id/etv_intro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.4"
                    android:alpha="0.7"
                    app:etv_MaxLinesOnShrink="10"
                    app:etv_ToExpandHint="@string/more"
                    app:etv_ToExpandHintColor="?attr/reader_brand_primary"
                    app:etv_ToShrinkHint="@string/pack_up"
                    app:etv_ToShrinkHintColor="?attr/reader_brand_primary"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:id="@+id/ll_start_reading"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginTop="2dp"
        android:paddingHorizontal="16dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_arrow_left"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_left"
            android:layout_marginEnd="4dp"
            app:tint="?attr/reader_text_primary"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/reader_text_primary"
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_start_reading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/novel_reader_desc_page_slide_tips"
            android:includeFontPadding="false"/>
    </LinearLayout>
</LinearLayout>
