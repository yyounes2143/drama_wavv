<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/theme_surface1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:orientation="vertical"
        android:id="@+id/refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_edit"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_edit"
        android:background="@color/theme_surface1"
        android:paddingLeft="@dimen/_12sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingRight="@dimen/_12sdp"
        android:paddingBottom="@dimen/_12sdp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textColor="@color/theme_text1"
            android:gravity="center"
            android:id="@+id/tv_select_all"
            android:background="@drawable/shape_conner_8_fill_2"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:text="@string/sr_mine_select_all"
            android:layout_weight="1"
            style="@style/theme_TextMedium16"/>
        <TextView
            android:enabled="false"
            android:textColor="@color/white_50"
            android:gravity="center"
            android:id="@+id/tv_delete"
            android:background="@drawable/mine_background_delete"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:text="@string/sr_mine_delete"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_8sdp"
            style="@style/theme_TextMedium16"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
